{
  "main": "lib/index.js",
  "type": "commonjs",
  "scripts": {
    "bundle": "npm run format:write && npm run package",
    "ci-test": "jest",
    "format:write": "prettier --write **/*.ts",
    "format:check": "prettier --check **/*.ts",
    "lint": "npx eslint .",
    "lint-fix": "npx eslint . --fix",
    "package": "ncc build src/index.ts --license licenses.txt && npm run create-wrappers",
    "create-wrappers": "node scripts/create-wrappers.js",
    "package:watch": "npm run package -- --watch",
    "test": "jest",
    "all": "npm run format:write && npm run lint && npm run test && npm run package"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vercel/ncc": "^0.38.4",
    "eslint": "^10.1.0",
    "eslint-plugin-github": "^6.0.0",
    "eslint-plugin-jest": "^29.15.1",
    "globals": "^17.4.0",
    "jest": "^30.3.0",
    "jest-mock-extended": "^4.0.0",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@actions/glob": "^0.6.1",
    "@actions/artifact": "^6.2.1",
    "@actions/core": "^3.0.0",
    "@actions/github": "^9.0.0",
    "@octokit/core": "^7.0.6",
    "@octokit/graphql": "^9.0.3",
    "@octokit/rest": "^22.0.1"
  },
  "overrides": {
    "glob": "^10.5.0"
  }
}
